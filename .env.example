# ==============================================================================
# Healthcare AI — Environment Configuration (.env.example)
# NASA Space Apps Challenge 2026
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=false

# API Key Security for Tunnel / Production Integration
# When set, all non-public endpoints require 'X-API-Key' or 'Authorization: Bearer <key>'.
# Leave empty for open local development.
AURAMED_API_KEY=auramed-secret-key-2026

# Structured Database (MySQL)
# Native service (MySQL94) or Dockerized container (infrastructure/docker-compose.yml)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=auramed_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Vector Database (ChromaDB)
VECTOR_DB_PROVIDER=chroma
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Embeddings (Local-first, candidate BGE-small)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Primary Cloud LLM Gateway (Google Gemini Multi-Project Pool / Groq fallback)
LLM_PRIMARY_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Local LLM Fallback (Native Ollama)
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Medical candidate model (pending user approval to pull): medgemma:4b
OLLAMA_MEDICAL_MODEL=medgemma:4b

# Reliability, Guardrails & Online-First / Offline-Fallback
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_FALLBACK_ENABLED=true
SYSTEM_OPERATING_MODE=online
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Google Gemini Multi-Project Key Pool (Voice & Chat Mode)
GEMINI_VOICE_PROJECTS_JSON=[{"project_id":"auramed-cloud-alpha","priority":1,"keys":[{"key":"YOUR_GEMINI_KEY_1","label":"alpha-primary"},{"key":"YOUR_GEMINI_KEY_2","label":"alpha-secondary"}]},{"project_id":"auramed-cloud-beta","priority":2,"keys":[{"key":"YOUR_GEMINI_KEY_3","label":"beta-primary"},{"key":"YOUR_GEMINI_KEY_4","label":"beta-secondary"}]},{"project_id":"auramed-cloud-gamma","priority":3,"keys":[{"key":"YOUR_GEMINI_KEY_5","label":"gamma-primary"},{"key":"YOUR_GEMINI_KEY_6","label":"gamma-secondary"}]},{"project_id":"auramed-cloud-delta","priority":4,"keys":[{"key":"YOUR_GEMINI_KEY_7","label":"delta-primary"},{"key":"YOUR_GEMINI_KEY_8","label":"delta-secondary"}]}]
GEMINI_PROJECTS_JSON=[{"project_id":"auramed-cloud-alpha","priority":1,"keys":[{"key":"YOUR_GEMINI_KEY_1","label":"alpha-primary"},{"key":"YOUR_GEMINI_KEY_2","label":"alpha-secondary"}]},{"project_id":"auramed-cloud-beta","priority":2,"keys":[{"key":"YOUR_GEMINI_KEY_3","label":"beta-primary"},{"key":"YOUR_GEMINI_KEY_4","label":"beta-secondary"}]},{"project_id":"auramed-cloud-gamma","priority":3,"keys":[{"key":"YOUR_GEMINI_KEY_5","label":"gamma-primary"},{"key":"YOUR_GEMINI_KEY_6","label":"gamma-secondary"}]},{"project_id":"auramed-cloud-delta","priority":4,"keys":[{"key":"YOUR_GEMINI_KEY_7","label":"delta-primary"},{"key":"YOUR_GEMINI_KEY_8","label":"delta-secondary"}]}]
GEMINI_VOICE_DEFAULT_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_DEFAULT_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_DEFAULT_VOICE=Kore
GEMINI_SILENCE_TIMEOUT_MS=1500

# Speech Generation (TTS) Gateway & Offline Fallback (NASA Space Apps 2026)
TTS_PRIMARY_PROVIDER=gemini
TTS_FALLBACK_PROVIDER=vibevoice
VIBEVOICE_MODEL_DIR=./models/VibeVoice-Realtime-0.5B
